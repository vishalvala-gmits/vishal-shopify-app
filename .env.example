# Required by @shopify/shopify-app-react-router (app/shopify.server.ts).
# shopify app dev injects these automatically in local dev; production hosting
# must set them explicitly. See docs/SHOPIFY-CONFIG.md and docs/DEPLOYMENT.md.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://app.example.com
SCOPES=read_products,write_products,read_online_store_pages,write_files

# NOTE: the database path is currently hardcoded in prisma/schema.prisma
# ("file:dev.sqlite"), not read from an env var. See docs/DEPLOYMENT.md.

# Used by unrelated storefront-API tooling in this repo, not by the embedded
# app's own OAuth/session flow.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=your_private_storefront_token
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=your_public_storefront_token
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token
