<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

<div
  class="jss-widget"
  id="jss-widget-{{ block.id }}"
  data-jss-widget
  data-shop="{{ shop.permanent_domain }}"
  data-product-id="{% if product %}gid://shopify/Product/{{ product.id }}{% endif %}"
  data-app-url="{{ block.settings.app_url }}"
  {{ block.shopify_attributes }}
>
  <div class="jss-loading" data-jss-loading>Loading savings scheme calculator...</div>
  <div class="jss-error" data-jss-error hidden>Savings scheme is currently unavailable.</div>

  <div class="jss-content" data-jss-content hidden>
    <div class="jss-grid">
      <!-- LEFT COLUMN: Monthly Contribution & Controls -->
      <div class="jss-col jss-col-controls">
        <h2 class="jss-title">Adjust your monthly premium</h2>

        <!-- Current Amount Display Card -->
        <div class="jss-amount-card">
          <span class="jss-amount-card-label">MONTHLY PREMIUM</span>
          <span class="jss-amount-card-value" data-jss-amount-display></span>
        </div>

        <!-- Interactive Slider with Milestone Pins -->
        <div class="jss-slider-wrapper">
          <div class="jss-slider-milestones" data-jss-slider-milestones>
            <!-- Pinned gift milestone icons placed by JS -->
          </div>
          <div class="jss-slider-container">
            <input
              type="range"
              class="jss-slider"
              data-jss-slider
              aria-label="Monthly premium amount"
            />
          </div>
          <div class="jss-slider-labels">
            <span class="jss-slider-boundary" data-jss-min-label></span>
            <span class="jss-slider-boundary" data-jss-max-label></span>
          </div>
        </div>

        <!-- Tiered Gift Benefit Cards (0-2, populated dynamically via JS) -->
        <div class="jss-gift-tiers" data-jss-gift-tiers hidden></div>

        <!-- OR Divider -->
        <div class="jss-divider">
          <span>OR</span>
        </div>

        <!-- Preset Quick-Select Amount Chips -->
        <div class="jss-presets" data-jss-presets>
          <!-- Buttons rendered dynamically via JS -->
        </div>

        <!-- Primary Action & Terms Checkbox -->
        <div class="jss-action-group">
          <button type="button" class="jss-cta-btn" data-jss-cta>CONTINUE</button>

          <label class="jss-terms-label">
            <input type="checkbox" class="jss-terms-checkbox" data-jss-terms />
            <span class="jss-terms-text" data-jss-terms-text>
              I agree to Terms &amp; Conditions.
            </span>
          </label>
        </div>

      </div>

      <!-- RIGHT COLUMN: Estimated Premium Summary & Early Redemption -->
      <div class="jss-col jss-col-summary">
        <h2 class="jss-title">Estimated Premium Summary</h2>

        <!-- Main Beige Summary Card -->
        <div class="jss-summary-card">
          <!-- Total Contribution Row -->
          <div class="jss-summary-item">
            <div class="jss-summary-item-left">
              <span class="jss-bullet jss-bullet-primary"></span>
              <div>
                <p class="jss-summary-item-label">Your Total Contribution</p>
                <p class="jss-summary-item-sublabel" data-jss-contribution-sub></p>
              </div>
            </div>
            <span class="jss-summary-item-val" data-jss-contribution></span>
          </div>

          <!-- Bonus Month Row -->
          <div class="jss-summary-item" data-jss-bonus-row hidden>
            <div class="jss-summary-item-left">
              <span class="jss-bullet jss-bullet-subdued"></span>
              <div>
                <p class="jss-summary-item-label">Bonus of Final Month</p>
                <p class="jss-summary-item-sublabel" data-jss-bonus-sub></p>
              </div>
            </div>
            <span class="jss-summary-item-val" data-jss-bonus></span>
          </div>

          <!-- Hero Dark Gift Card(s) - only eligible gifts are shown, populated via JS -->
          <div class="jss-hero-gift-list" data-jss-gift-card hidden></div>

          <!-- Total Benefit Value Row -->
          <div class="jss-summary-item jss-summary-item-highlight">
            <div class="jss-summary-item-left">
              <span class="jss-bullet jss-bullet-success"></span>
              <div>
                <p class="jss-summary-item-label jss-label-success">Total Benefit Value</p>
                <p class="jss-summary-item-sublabel" data-jss-benefit-sub></p>
              </div>
            </div>
            <span class="jss-summary-item-val jss-val-success" data-jss-benefit></span>
          </div>

          <!-- You Actually Spend Row -->
          <div class="jss-summary-spend-row">
            <span>You Actually Spend</span>
            <span data-jss-spend></span>
          </div>
        </div>

        <!-- Early Redemption Flexibility Grid -->
        <div class="jss-redemption-section" data-jss-redemption-section hidden>
          <h3 class="jss-redemption-heading" data-jss-redemption-title>
            Need Flexibility? Redeem Early After 6 Months
          </h3>
          <div class="jss-redemption-grid" data-jss-redemption-grid>
            <!-- 2x2 grid populated dynamically via JS -->

            <!-- Redemption detail popover: anchored above/below the hovered
                 or tapped card, stays within this grid's own bounds -->
            <div class="jss-redemption-popover" data-jss-redemption-popover hidden role="tooltip">
              <button type="button" class="jss-redemption-popover-close" data-jss-popover-close aria-label="Close">&times;</button>
              <p class="jss-redemption-popover-title" data-jss-popover-title></p>
              <div class="jss-redemption-popover-row">
                <span>Your total payment</span>
                <strong data-jss-popover-payment></strong>
              </div>
              <p class="jss-redemption-popover-note" data-jss-popover-payment-note></p>
              <div class="jss-redemption-popover-row">
                <span>Bonus Benefit</span>
                <strong data-jss-popover-bonus></strong>
              </div>
              <p class="jss-redemption-popover-note" data-jss-popover-bonus-note></p>
              <div class="jss-redemption-popover-highlight">
                <span data-jss-popover-worth-label></span>
                <strong data-jss-popover-worth></strong>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Enquiry modal: opened from the CONTINUE button -->
  <div class="jss-modal-backdrop" data-jss-enquiry-backdrop hidden></div>
  <div class="jss-modal" data-jss-enquiry-modal hidden role="dialog" aria-modal="true" aria-labelledby="jss-enquiry-heading-{{ block.id }}">
    <button type="button" class="jss-modal-close" data-jss-enquiry-close aria-label="Close">&times;</button>

    <form class="jss-enquiry-form" data-jss-enquiry-form>
      <h3 class="jss-form-heading" id="jss-enquiry-heading-{{ block.id }}">Complete Your Enquiry</h3>
      <p class="jss-form-subheading">Provide your details to register interest and lock today's rate. No immediate payment is required.</p>
      <label class="jss-field">
        <span>Full Name *</span>
        <input type="text" name="name" data-jss-input-name required placeholder="e.g. Priya Sharma" />
      </label> 
      <label class="jss-field">
        <span>Phone Number *</span>
        <div class="jss-phone-field">
          <span class="jss-phone-prefix">+91</span>
          <input type="tel" name="phone" data-jss-input-phone placeholder="9876543210" />
        </div>
      </label>         
      <label class="jss-field">
          <span>Email Address</span>
          <input type="email" name="email" data-jss-input-email placeholder="e.g. priya@example.com" />
        </label>
      <p class="jss-form-error" data-jss-form-error hidden></p>

      <div class="jss-plan-summary">
        <div>
          <span class="jss-plan-summary-label">PLAN SELECTED</span>
          <span class="jss-plan-summary-value" data-jss-modal-plan></span>
        </div>
        <div class="jss-plan-summary-benefit" data-jss-modal-benefit-wrap hidden>
          <span class="jss-plan-summary-label">GOLD BENEFIT</span>
          <span class="jss-plan-summary-value jss-plan-summary-benefit-value" data-jss-modal-benefit></span>
        </div>
      </div>

      <button type="submit" class="jss-cta-btn" data-jss-submit>Submit Enquiry</button>

      <div class="jss-trust-row">
        <span><span class="jss-trust-icon">&#10003;</span> Verified Vault Partner</span>
        <span class="jss-trust-dot">&bull;</span>
        <span><span class="jss-trust-icon">&#128274;</span> 256-Bit SSL Encrypted</span>
      </div>
    </form>

    <div class="jss-success" data-jss-success hidden>
      <p>✓ Enquiry submitted successfully! Our representative will contact you shortly.</p>
      <button type="button" class="jss-cta-btn" data-jss-success-close>Close</button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Savings Scheme Widget",
  "target": "section",
  "stylesheet": "savings-scheme.css",
  "javascript": "savings-scheme.js",
  "settings": [
    {
      "type": "text",
      "id": "app_url",
      "label": "App URL",
      "info": "Base URL of the app backend, e.g. https://your-app.example.com"
    }
  ]
}
{% endschema %}
