// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model SavingsScheme {
  id              String   @id @default(cuid())
  shop            String

  name            String
  durationMonths  Int
  bonusEnabled    Boolean  @default(false)
  bonusMonths     Int      @default(0)
  minAmount       Int
  maxAmount       Int
  presetAmounts   Json

  // Array of up to 2 gift configs: { enabled, name, value, imageUrl, minAmount }.
  // Migrated from the legacy single-gift scalar columns (giftEnabled/giftName/
  // giftValue/giftImageUrl/giftMinAmount) — see migration
  // 20260909000000_add_gifts_array_to_scheme.
  gifts                    Json     @default("[]")

  popularAmount            Int?
  earlyRedemptionEnabled   Boolean  @default(true)
  earlyRedemptionMinMonths Int      @default(6)
  // No DB-level default: the shop-name-aware default text is applied by
  // upsertSchemeForShop() only when creating a brand-new scheme (see
  // buildDefaultTermsText in savingsScheme.server.ts), never overwriting an
  // existing merchant value.
  termsText                String?

  currencySymbol           String   @default("₹")
  primaryColor             String   @default("#5C4642")
  status                   String   @default("active")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  enquiries       SavingsEnquiry[]

  @@index([shop])
  @@index([shop, status])
}

model SavingsEnquiry {
  id                  String   @id @default(cuid())
  shop                String
  schemeId            String
  shopifyProductId    String?

  customerName        String
  customerEmail       String?
  customerPhone       String?

  monthlyAmount       Int
  durationMonths      Int
  bonusAmount         Int
  totalContribution   Int
  totalBenefit        Int

  giftName            String?
  giftValue           Int?
  giftEligible        Boolean  @default(false)
  // Snapshot of every gift the customer was eligible for at submission time,
  // recalculated server-side (never trusts client input): array of
  // { name, value, imageUrl, minAmount }. Legacy giftName/giftValue/giftEligible
  // columns above are preserved for old records and mirror gifts[0] when present.
  giftsSnapshot       Json?
  sourceUrl           String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  scheme              SavingsScheme @relation(fields: [schemeId], references: [id], onDelete: Restrict)

  @@index([shop])
  @@index([shop, schemeId])
  @@index([shop, createdAt])
}
